{
  "schema_version": 1,
  "purpose": "Auditable, executable carbohydrate-NMR knowledge. Every scientific rule must identify its source, locator, applicability, and how the software may use it.",
  "sources": {
    "bubb_2003": {
      "citation": "W. A. Bubb, NMR Spectroscopy in the Study of Carbohydrates: Characterizing the Structural Complexity, Concepts in Magnetic Resonance Part A 19A (2003) 1-19",
      "doi": "10.1002/cmr.a.10080",
      "verification": "verified_against_local_pdf",
      "local_file": "../papers/2003 - Bubb -carbohydrates Characterizing the structural.pdf"
    },
    "duus_2000": {
      "citation": "J. O. Duus, C. H. Gotfredsen, and K. Bock, Carbohydrate Structural Determination by NMR Spectroscopy: Modern Methods and Limitations, Chemical Reviews 100 (2000) 4589-4614",
      "doi": "10.1021/cr990302n",
      "verification": "verified_against_local_pdf",
      "local_file": "../papers/fructose/carbohydrate-structural-determination-by-nmr-spectroscopy-modern-methods-and-limitations.pdf"
    }
  },
  "rules": [
    {
      "id": "bubb.1h.anomeric_reporter_region",
      "source": "bubb_2003",
      "locator": "journal page 8, Basic 1H NMR Data",
      "statement": "Anomeric proton signals are commonly well resolved in approximately the 4.4-5.5 ppm region.",
      "rule_type": "spectral_reporter_region",
      "measurement": "proton_shift_ppm",
      "region": [4.4, 5.5],
      "applies_when": {"nucleus": "1H", "anomeric_proton_present": true},
      "software_use": "detection_and_explanation",
      "confidence": "review_rule"
    },
    {
      "id": "bubb.1h.acetyl_reporter_region",
      "source": "bubb_2003",
      "locator": "journal page 8, Basic 1H NMR Data",
      "statement": "Acetyl proton signals occur at approximately 2.0-2.1 ppm.",
      "rule_type": "spectral_reporter_region",
      "measurement": "proton_shift_ppm",
      "region": [2.0, 2.1],
      "applies_when": {"nucleus": "1H", "acetyl_group_present": true},
      "software_use": "candidate_conditioned_scoring",
      "confidence": "review_rule"
    },
    {
      "id": "bubb.1h.methyl_reporter_region",
      "source": "bubb_2003",
      "locator": "journal page 8, Basic 1H NMR Data",
      "statement": "Diagnostic carbohydrate methyl proton signals occur at approximately 1.2 ppm.",
      "rule_type": "spectral_reporter_region",
      "measurement": "proton_shift_ppm",
      "region": [1.1, 1.3],
      "implementation_note": "The 1.1-1.3 ppm detection window is an explicit software tolerance around the paper's approximate 1.2 ppm value.",
      "applies_when": {"nucleus": "1H", "methyl_group_present": true},
      "software_use": "candidate_conditioned_scoring",
      "confidence": "review_rule_with_implementation_tolerance"
    },
    {
      "id": "bubb.1h.crowded_nonanomeric_region",
      "source": "bubb_2003",
      "locator": "journal page 8, Basic 1H NMR Data",
      "statement": "Most carbohydrate proton resonances cluster at approximately 3.4-4.0 ppm.",
      "rule_type": "spectral_caution_region",
      "measurement": "proton_shift_ppm",
      "region": [3.4, 4.0],
      "applies_when": {"nucleus": "1H"},
      "software_use": "warning",
      "confidence": "review_rule"
    },
    {
      "id": "bubb.1h.non_first_order_warning",
      "source": "bubb_2003",
      "locator": "journal page 8, Basic 1H NMR Data",
      "statement": "Because nonanomeric proton shifts have limited dispersion, carbohydrate proton spectra are often not first order and line separations need not equal coupling constants.",
      "rule_type": "interpretation_guardrail",
      "applies_when": {"nucleus": "1H", "region_character": "crowded_or_strongly_coupled"},
      "software_use": "blocks_automatic_J_assignment",
      "confidence": "review_rule"
    },
    {
      "id": "bubb.j12.alpha_d_pyranose",
      "source": "bubb_2003",
      "supporting_sources": ["duus_2000"],
      "supporting_locators": {"duus_2000": "journal page 4593, section 3 Anomeric Configuration"},
      "locator": "journal page 8, Structural-Reporter Groups",
      "statement": "A 2-4 Hz J1,2 is characteristic of the equatorial-axial relationship commonly associated with alpha D-pyranose anomers.",
      "rule_type": "coupling_range",
      "measurement": "J1,2_hz",
      "expected_range": [2.0, 4.0],
      "form": "alpha",
      "profiles": ["glucose", "xylose", "sucrose"],
      "applies_when": {"ring": "pyranose", "series": "D", "H2_orientation": "axial"},
      "software_use": "candidate_conditioned_scoring",
      "confidence": "review_rule"
    },
    {
      "id": "bubb.j12.beta_d_pyranose",
      "source": "bubb_2003",
      "supporting_sources": ["duus_2000"],
      "supporting_locators": {"duus_2000": "journal page 4593, section 3 Anomeric Configuration"},
      "locator": "journal page 8, Structural-Reporter Groups",
      "statement": "A 7-9 Hz J1,2 is characteristic of the diaxial relationship commonly associated with beta D-pyranose anomers.",
      "rule_type": "coupling_range",
      "measurement": "J1,2_hz",
      "expected_range": [7.0, 9.0],
      "form": "beta",
      "profiles": ["glucose", "xylose"],
      "applies_when": {"ring": "pyranose", "series": "D", "H2_orientation": "axial"},
      "software_use": "candidate_conditioned_scoring",
      "confidence": "review_rule"
    },
    {
      "id": "bubb.j12.alpha_d_mannose",
      "source": "bubb_2003",
      "locator": "journal page 8, Structural-Reporter Groups",
      "statement": "For alpha D-mannose, the typical J1,2 between diequatorial protons is 1.6 Hz.",
      "rule_type": "coupling_typical_value",
      "measurement": "J1,2_hz",
      "typical_value": 1.6,
      "implementation_range": [1.1, 2.1],
      "implementation_note": "The +/-0.5 Hz scoring interval is a software tolerance, not a range quoted by Bubb.",
      "form": "alpha",
      "profiles": ["mannose"],
      "applies_when": {"ring": "pyranose", "series": "D", "sugar": "mannose"},
      "software_use": "candidate_conditioned_scoring",
      "confidence": "quoted_typical_value_with_implementation_tolerance"
    },
    {
      "id": "bubb.j12.beta_d_mannose",
      "source": "bubb_2003",
      "locator": "journal page 8, Structural-Reporter Groups",
      "statement": "For beta D-mannose, the typical axial-equatorial J1,2 is 0.8 Hz.",
      "rule_type": "coupling_typical_value",
      "measurement": "J1,2_hz",
      "typical_value": 0.8,
      "implementation_range": [0.4, 1.2],
      "implementation_note": "The asymmetric scoring interval is a software tolerance, not a range quoted by Bubb.",
      "form": "beta",
      "profiles": ["mannose"],
      "applies_when": {"ring": "pyranose", "series": "D", "sugar": "mannose"},
      "software_use": "candidate_conditioned_scoring",
      "confidence": "quoted_typical_value_with_implementation_tolerance"
    },
    {
      "id": "bubb.reporters.residue_specific",
      "source": "bubb_2003",
      "locator": "journal page 8, Structural-Reporter Groups",
      "statement": "Useful residue-specific reporter groups include H1 generally; mannose H2/H3; fucose H5/methyl; galactose H4/H5; and selected sialic-acid and N-acetyl signals.",
      "rule_type": "reporter_group_catalog",
      "reporter_groups": {
        "general": ["H1"],
        "mannose": ["H2", "H3"],
        "fucose": ["H5", "CH3"],
        "galactose": ["H4", "H5"],
        "sialic_acid": ["H3ax", "H3eq"],
        "N_acetyl_sugars": ["acetyl_CH3"]
      },
      "applies_when": {"task": "carbohydrate_residue_assignment"},
      "software_use": "assignment_priority",
      "confidence": "review_rule"
    },
    {
      "id": "duus.jhh.axial_axial",
      "source": "duus_2000",
      "locator": "journal page 4593, section 3 Anomeric Configuration",
      "statement": "Two axial protons in a pyranose commonly have a large vicinal coupling of 7-8 Hz.",
      "rule_type": "coupling_geometry",
      "measurement": "vicinal_JHH_hz",
      "expected_range": [7.0, 8.0],
      "applies_when": {"ring": "pyranose", "relationship": "axial_axial"},
      "software_use": "stereochemical_consistency_check",
      "confidence": "review_rule"
    },
    {
      "id": "duus.jhh.equatorial_axial",
      "source": "duus_2000",
      "locator": "journal page 4593, section 3 Anomeric Configuration",
      "statement": "An equatorial-axial relationship in a pyranose commonly gives a vicinal coupling of approximately 4 Hz.",
      "rule_type": "coupling_geometry",
      "measurement": "vicinal_JHH_hz",
      "typical_value": 4.0,
      "applies_when": {"ring": "pyranose", "relationship": "equatorial_axial"},
      "software_use": "stereochemical_consistency_check",
      "confidence": "review_rule"
    },
    {
      "id": "duus.jhh.axial_equatorial_or_equatorial_equatorial",
      "source": "duus_2000",
      "locator": "journal page 4593, section 3 Anomeric Configuration",
      "statement": "Axial-equatorial or equatorial-equatorial vicinal relationships in pyranoses commonly give couplings below 2 Hz.",
      "rule_type": "coupling_geometry",
      "measurement": "vicinal_JHH_hz",
      "upper_bound": 2.0,
      "applies_when": {"ring": "pyranose", "relationship": ["axial_equatorial", "equatorial_equatorial"]},
      "software_use": "stereochemical_consistency_check",
      "confidence": "review_rule"
    },
    {
      "id": "duus.1jch.alpha_d_pyranose",
      "source": "duus_2000",
      "locator": "journal page 4594, section 3 Anomeric Configuration",
      "statement": "For D sugars in the 4C1 pyranose conformation, an anomeric one-bond 1JC1,H1 near 170 Hz indicates alpha configuration.",
      "rule_type": "heteronuclear_coupling_typical_value",
      "measurement": "1JC1,H1_hz",
      "typical_value": 170.0,
      "form": "alpha",
      "applies_when": {"ring": "pyranose", "series": "D", "conformation": "4C1"},
      "excludes": {"ring": "furanose"},
      "software_use": "optional_13C_1H_confirmation",
      "confidence": "review_rule"
    },
    {
      "id": "duus.1jch.beta_d_pyranose",
      "source": "duus_2000",
      "locator": "journal page 4594, section 3 Anomeric Configuration",
      "statement": "For D sugars in the 4C1 pyranose conformation, an anomeric one-bond 1JC1,H1 near 160 Hz indicates beta configuration.",
      "rule_type": "heteronuclear_coupling_typical_value",
      "measurement": "1JC1,H1_hz",
      "typical_value": 160.0,
      "form": "beta",
      "applies_when": {"ring": "pyranose", "series": "D", "conformation": "4C1"},
      "excludes": {"ring": "furanose"},
      "software_use": "optional_13C_1H_confirmation",
      "confidence": "review_rule"
    },
    {
      "id": "duus.appended_group.proton_shift",
      "source": "duus_2000",
      "locator": "journal page 4594, section 5 Position of Appended Groups",
      "statement": "Attachment of methyl, acetyl, sulfate, or phosphate groups commonly causes proton downfield shifts of approximately 0.2-0.5 ppm at the modified location.",
      "rule_type": "substitution_shift_delta",
      "measurement": "proton_shift_delta_ppm",
      "expected_range": [0.2, 0.5],
      "applies_when": {"modification": ["methyl", "acetyl", "sulfate", "phosphate"]},
      "software_use": "optional_modified_sugar_check",
      "confidence": "review_rule"
    },
    {
      "id": "duus.metadata.ph_required_for_charged_groups",
      "source": "duus_2000",
      "locator": "journal page 4594, section 6 Classical NMR Methods",
      "statement": "Sample pH should be reported when comparing carbohydrates containing charged groups such as Kdo or phosphate.",
      "rule_type": "metadata_requirement",
      "applies_when": {"charged_group_present": true},
      "required_metadata": ["pH"],
      "software_use": "quality_gate",
      "confidence": "review_rule"
    },
    {
      "id": "duus.assignment.multidimensional_evidence",
      "source": "duus_2000",
      "locator": "journal pages 4592-4596, assignment strategy and methods",
      "statement": "TOCSY/COSY and heteronuclear HSQC/HMQC/HMBC evidence are complementary tools for residue assignment, carbon correlation, and linkage analysis when proton signals overlap.",
      "rule_type": "evidence_requirement",
      "recommended_experiments": ["COSY", "TOCSY", "HSQC", "HMQC", "HMBC"],
      "applies_when": {"task": "carbohydrate_structure_assignment", "signals": "overlapping_or_unassigned"},
      "software_use": "confirmation_gate",
      "confidence": "review_synthesis"
    }
  ]
}
